{
  "name": "ibm5100-sim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "model": "gltf-transform optimize ibm5100.glb public/models/ibm5100.web.glb --compress false --texture-compress webp --texture-size 2048 --join false --flatten false --instance false --simplify false --palette false",
    "test:basic": "esbuild tools/test-basic.ts --bundle --platform=node --outfile=tools/.tmp/test-basic.cjs --log-level=warning && node tools/.tmp/test-basic.cjs",
    "smoke": "node tools/smoke.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "postprocessing": "^6.39.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.7.0",
    "puppeteer-core": "^23.11.1",
    "typescript": "~5.6.3",
    "vite": "^5.4.21"
  }
}
